#!/usr/bin/env python3
"""Stands in for `claude plugin …` in tests. Mirrors what Claude Code 2.1
does and refuses, as observed against the real CLI in a scratch home:

  - `marketplace add` takes owner/repo, owner/repo#ref, <git-url>#ref, a
    marketplace.json URL or a directory path, and rejects file://
  - a github or git marketplace is a clone under ~/.claude/plugins/marketplaces;
    github repos are fetched from https://github.com/<repo>.git, which a test
    points at local bare repositories with git's url.<base>.insteadOf
  - `marketplace add` refuses to re-point a marketplace whose user-settings
    entry names another source; `marketplace update` refreshes the clone
  - `install` records version, installPath and gitCommitSha; the version is
    plugin.json's, else the marketplace entry's, else the commit's first 12
    hex digits
  - `update` moves to whatever the catalog offers, downgrades included, and
    does nothing at the same version; `uninstall` of a missing plugin exits 1

Every call is appended to $HOME/claude-calls.log.
"""
import json, os, re, shutil, subprocess, sys, time

HOME = os.environ["HOME"]
CLAUDE = os.path.join(HOME, ".claude")
PLUGINS = os.path.join(CLAUDE, "plugins")
RECORD = os.path.join(PLUGINS, "installed_plugins.json")
KNOWN = os.path.join(PLUGINS, "known_marketplaces.json")
a = sys.argv[1:]
open(os.path.join(HOME, "claude-calls.log"), "a").write(" ".join(a) + "\n")


def die(msg):
    print(msg)
    sys.exit(1)


def load(p, default):
    return json.load(open(p)) if os.path.exists(p) else default


def save(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(d, open(p, "w"), indent=2)


def opt(name):
    return a[a.index(name) + 1] if name in a else None


def settings_file(scope):
    return {"user": os.path.join(CLAUDE, "settings.json"),
            "project": os.path.join(os.getcwd(), ".claude", "settings.json"),
            "local": os.path.join(os.getcwd(), ".claude", "settings.local.json")}[scope]


def git(*args, cwd=None):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        die("✘ git " + " ".join(args) + ": " + r.stderr.strip())
    return r.stdout.strip()


def head(loc):
    if not os.path.isdir(os.path.join(loc, ".git")):
        return None
    return git("rev-parse", "HEAD", cwd=loc)


def parse(src):
    if src.startswith("file://"):
        die("✘ Invalid marketplace source format. Try: owner/repo, https://..., or ./path")
    if src.startswith(("/", "./", "../", "~")):
        path = os.path.abspath(os.path.expanduser(src))
        if not os.path.isdir(path):
            die(f"✘ Path does not exist: {path}")
        return {"source": "directory", "path": path}
    m = re.match(r"^([^#]+)(?:#(.+))?$", src)
    url, ref = m.group(1), m.group(2)
    if url.startswith(("https://", "http://")) or re.match(r"^[\w.-]+@[^:]+:", url):
        if url.endswith(".git") or url.startswith("git@"):
            return {"source": "git", "url": url, **({"ref": ref} if ref else {})}
        return {"source": "url", "url": url}
    m = re.match(r"^([^#@]+)(?:[#@](.+))?$", src)
    return {"source": "github", "repo": m.group(1), **({"ref": m.group(2)} if m.group(2) else {})}


def fetch(source, dest):
    url = source.get("url") or f"https://github.com/{source['repo']}.git"
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    git("clone", "--quiet", *(["--branch", source["ref"]] if source.get("ref") else []), url, dest)


def catalog_name(loc):
    return json.load(open(os.path.join(loc, ".claude-plugin", "marketplace.json")))["name"]


def declare(scope, name, source):
    f = settings_file(scope)
    d = load(f, {})
    d.setdefault("extraKnownMarketplaces", {})[name] = {"source": source}
    save(f, d)


def marketplace_add(src, scope):
    if os.environ.get("STUB_FAIL_ADD"):
        die("✘ network unreachable")
    source = parse(src)
    if source["source"] == "directory":
        loc, name = source["path"], catalog_name(source["path"])
    else:
        tmp = os.path.join(PLUGINS, "marketplaces", f".tmp-{os.getpid()}")
        fetch(source, tmp)
        name = catalog_name(tmp)
        loc = os.path.join(PLUGINS, "marketplaces", name)
    user = load(settings_file("user"), {}).get("extraKnownMarketplaces", {}).get(name)
    if user and user.get("source") != source:
        if source["source"] != "directory":
            shutil.rmtree(tmp, ignore_errors=True)
        die(f'✘ Failed to add marketplace: Cannot add marketplace "{name}": its source doesn\'t match its '
            'extraKnownMarketplaces entry in user or managed settings; add it from the source that entry '
            'lists, or change the entry.')
    known = load(KNOWN, {})
    if source["source"] != "directory":
        if known.get(name, {}).get("source") == source and os.path.isdir(loc):
            shutil.rmtree(tmp)
        else:
            shutil.rmtree(loc, ignore_errors=True)
            os.rename(tmp, loc)
    known[name] = {"source": source, "installLocation": loc, "lastUpdated": time.strftime("%Y-%m-%dT%H:%M:%SZ")}
    save(KNOWN, known)
    declare(scope, name, source)
    print(f"✔ Successfully added marketplace: {name}")


def marketplace_update(name):
    known = load(KNOWN, {})
    if name not in known:
        die(f"✘ Failed to update marketplace(s): Marketplace '{name}' not found.")
    if os.environ.get("STUB_FAIL_UPDATE"):
        die("✘ network unreachable")
    m = known[name]
    if m["source"]["source"] != "directory":
        fetch(m["source"], m["installLocation"])
    print(f"✔ Successfully updated marketplace: {name}")


def offer(key):
    """What the marketplace offers now: (version, sha, plugin directory)."""
    plugin, name = key.split("@", 1)
    m = load(KNOWN, {}).get(name)
    if not m:
        die(f'✘ Plugin "{plugin}" not found in marketplace "{name}"')
    loc = m["installLocation"]
    entry = next((p for p in json.load(open(os.path.join(loc, ".claude-plugin", "marketplace.json")))["plugins"]
                  if p["name"] == plugin), None)
    if entry is None:
        die(f'✘ Plugin "{plugin}" not found in marketplace "{name}"')
    pdir = os.path.normpath(os.path.join(loc, entry["source"]))
    manifest = load(os.path.join(pdir, ".claude-plugin", "plugin.json"), {})
    sha = head(loc)
    version = manifest.get("version") or entry.get("version") or (sha or "unknown")[:12]
    return version, sha, pdir


scope = opt("--scope") or opt("-s") or "user"
key = a[-1] if a else ""
here = os.path.realpath(os.getcwd())
mine = lambda r: r["scope"] == scope and (scope == "user" or r.get("projectPath") == here)

if a[:1] != ["plugin"]:
    sys.exit(0)
if a[1:3] == ["marketplace", "add"]:
    marketplace_add(key, scope)
    sys.exit(0)
if a[1:3] == ["marketplace", "update"]:
    marketplace_update(key)
    sys.exit(0)


def materialize(key, rows):
    version, sha, pdir = offer(key)
    plugin, name = key.split("@", 1)
    path = os.path.join(PLUGINS, "cache", name, plugin, version)
    shutil.rmtree(path, ignore_errors=True)
    shutil.copytree(pdir, path)
    rows.append({"scope": scope, **({} if scope == "user" else {"projectPath": here}),
                 "installPath": path, "version": version, **({"gitCommitSha": sha} if sha else {})})
    return version


if a[1] in ("install", "i"):
    if os.environ.get("STUB_FAIL_INSTALL"):
        die("✘ network unreachable")
    if "--marketplace" in a and "@" in key:
        die("✘ Name the marketplace once: <plugin>@<marketplace>, or claude plugin install <plugin> --marketplace <source>")
    d = load(RECORD, {"version": 2, "plugins": {}})
    rows = [r for r in d["plugins"].get(key, []) if not mine(r)]
    materialize(key, rows)
    d["plugins"][key] = rows
    save(RECORD, d)
    f = settings_file(scope)
    s = load(f, {})
    s.setdefault("enabledPlugins", {})[key] = True
    save(f, s)
    print(f"✔ Successfully installed plugin: {key} (scope: {scope})")
    sys.exit(0)
if a[1] == "update":
    d = load(RECORD, {"version": 2, "plugins": {}})
    rows = d["plugins"].get(key, [])
    old = next((r for r in rows if mine(r)), None)
    if old is None:
        die(f'✘ Plugin "{key}" is not installed in {scope} scope.')
    version, _, _ = offer(key)
    if version == old["version"]:
        print(f"✔ {key.split('@')[0]} is already at the latest version ({version}).")
        sys.exit(0)
    rows = [r for r in rows if not mine(r)]
    materialize(key, rows)
    d["plugins"][key] = rows
    save(RECORD, d)
    print(f'✔ Plugin "{key}" updated from {old["version"]} to {version}')
    sys.exit(0)
if a[1] == "uninstall":
    d = load(RECORD, {"version": 2, "plugins": {}})
    rows = d["plugins"].get(key, [])
    if not any(mine(r) for r in rows):
        die(f'✘ Failed to uninstall plugin "{key}": Plugin "{key}" is not installed in {scope} scope.')
    d["plugins"][key] = [r for r in rows if not mine(r)]
    save(RECORD, d)
    f = settings_file(scope)
    s = load(f, {})
    s.get("enabledPlugins", {}).pop(key, None)
    save(f, s)
    print(f"✔ Successfully uninstalled plugin: {key}")
    sys.exit(0)
sys.exit(0)
